@using MvcStok.Models.Entity
@model List<TBLMUSTERILER>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@using (Html.BeginForm("Index","Musteri",FormMethod.Get))
{ 
  <p>
      <b>Aranacak Müşteri Adı:</b> @Html.TextBox("p")
      <input type="submit" value="Ara"/>
  </p>
}

<table class=" table table bordered">
    <tr>
        <th>Müşteri ID</th>
        <th>Müşteri Adı</th>
        <th>Müşteri Soyadı</th>
        <th>SİL</th>
        <th>GÜNCELLE</th>
        <th>ALERT</th>
    </tr>
    <tbody>
        @foreach (var mst in Model)
        { 
          <tr>
              <th>@mst.MUSTERIID</th>
              <td>@mst.MUSTERIAD</td>
              <td>@mst.MUSTERISOYAD</td>
              <td><a href="/MUSTERI/SIL/@mst.MUSTERIID" class="btn btn-danger">SİL</a></td>
              <td><a href="/MUSTERI/MusteriGetir/@mst.MUSTERIID" class="btn btn-success">GÜNCELLE</a></td>
              <td>@Html.ActionLink("SİL BUTONU", "SIL", new { id=mst.MUSTERIID }, new { @class = "btn btn-warning", onclick = "return confirm('Gerçekten Silmek İstiyor musunuz?')" })</td> @*onclick tıkladığında return confirm ile onay gelirse confirm true dönecek ve silme işlemi gerçekleşecek, onay gelmezse false dönecek ve silme işlemi gerçekleşmeyecek.*@

          </tr>
        
        }
    </tbody>

</table>
<a href="/MUSTERI/YeniMusteri/" class="btn btn-primary">YENİ MÜŞTERİ EKLE</a>
<link href="~/Content/DataTables/css/dataTables.bootstrap4.css" rel="stylesheet" />
@*<script type="text/javascript" src=""></script>*@
